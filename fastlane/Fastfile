# N Keto Tracker — Google Play yayın lane'leri (DoctorFilter/Halen standardı)
#
#   fastlane build_release      → imzalı, gizlenmiş (obfuscate) AAB (reklam/satın alma yok)
#   fastlane deploy_internal    → AAB'yi İç test kanalına yükler
#   fastlane deploy_production  → İç testteki sürümü Üretim'e taşır + mağaza içeriği
#   fastlane push_metadata      → yalnızca mağaza metin/görselleri
#
# İmza, kimlikler ve mağaza içeriği yalnızca yayın kökünde durur
# (D:\AppPublishing, protokol README.md; APP_PUBLISHING_ROOT ile değiştirilir).
# Bu açık kaynak repoda anahtar/gerçek kimlik tutulmaz.

default_platform(:android)

AAB_PATH = File.expand_path("../build/app/outputs/bundle/release/app-release.aab", __dir__)
PUBSPEC = File.read(File.expand_path("../pubspec.yaml", __dir__))
VERSION_NAME = PUBSPEC[/^version: ([^+\s]+)/, 1]
VERSION_CODE = PUBSPEC[/^version: .*\+(\d+)/, 1].to_i

PUBLISHING_ROOT = ENV.fetch("APP_PUBLISHING_ROOT", "D:/AppPublishing")
APP_DIR = File.join(PUBLISHING_ROOT, "apps/n-keto-tracker")
METADATA_PATH = File.join(APP_DIR, "stores/google-play/metadata")
SIGNING = File.join(APP_DIR, "credentials/android/key.properties")
# R8/obfuscate sembolleri repo dışında (crash çözümlemesi için saklanır).
SYMBOLS_DIR = ENV.fetch("NKETO_SYMBOLS_DIR", File.join(Dir.home, "AppData/Local/n-keto-symbols", "#{VERSION_NAME}+#{VERSION_CODE}"))

platform :android do
  desc "İmzalı sürüm AAB'si (yayın kökündeki imza)"
  lane :build_release do
    UI.user_error!("İmza dosyası yok: #{SIGNING}") unless File.exist?(SIGNING)
    ENV["NKETO_SIGNING"] = SIGNING
    FileUtils.mkdir_p(SYMBOLS_DIR)
    sh("flutter", "build", "appbundle", "--release", "--obfuscate",
       "--split-debug-info=#{SYMBOLS_DIR}")
    UI.success("AAB hazır: #{AAB_PATH} (semboller: #{SYMBOLS_DIR})")
  end

  desc "AAB'yi İç test (internal) kanalına yükler"
  lane :deploy_internal do
    supply(
      track: "internal",
      aab: AAB_PATH,
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "İç testteki pubspec sürümünü Üretim'e taşır ve mağaza içeriğini yükler"
  lane :deploy_production do
    supply(
      track: "internal",
      track_promote_to: "production",
      version_code: VERSION_CODE,
      # İlk yayında uygulama Play'de "taslak": API yalnız draft sürüm kabul eder,
      # gönderim Console > Yayınlama özeti'nden yapılır. Sonrakilerde completed.
      track_promote_release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
      metadata_path: METADATA_PATH,
    )
  end

  desc "Yalnızca mağaza metinleri ve görselleri"
  lane :push_metadata do
    supply(
      track: "internal",
      version_code: VERSION_CODE,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      metadata_path: METADATA_PATH,
    )
  end
end
