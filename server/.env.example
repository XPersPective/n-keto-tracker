# Sırlar repoya girmez. Servis hesabı JSON dosyası Play Console > API erişimi
# ile bağlanan hesaptan indirilir ve yalnız sunucuda tutulur.
PACKAGE_NAME=com.crazypenguin.nketotracker
PREMIUM_PRODUCT_ID=com.crazypenguin.nketotracker.pro_lifetime
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/play-service-account.json
PORT=8080
